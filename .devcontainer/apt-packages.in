# Базові пакети для стабільної роботи devcontainer image.
ca-certificates
curl
locales
sudo
tzdata
ssh
git

# Python 3 з pip/venv: потрібен PlatformIO IDE extension, яка сама
# створює venv і встановлює platformio через pip при першому запуску.
# Ubuntu noble не тягне ensurepip/venv в комплекті з python3 за
# замовчуванням - без цих пакетів PlatformIO падає з
# "Can not find working Python 3.6+ Interpreter".
python3-pip
python3-venv
python-is-python3

# C++ toolchain і language server для редактора.
gcc
clang
clangd
clang-tidy

# Runtime-бібліотеки Clang sanitizer-ів і symbolizer для читабельного ASan/UBSan output.
libclang-rt-18-dev
llvm-18

# Крос-тулчейн для ARM64-пристроїв: RPi4, Radxa ROCK 5B+, Jetson.
g++-aarch64-linux-gnu

# Інструменти для заняття 2.4: локальний і remote debug, memory diagnostics.
gdb
gdbserver
gdb-multiarch
valgrind

# Візуальний моніторинг CPU, RAM і процесів під час ROS 2 demo 5.5.
btop

# Інструменти збірки і форматери, які використовуються в лекціях та CI.
make
cmake
clang-format
cmake-format
ninja-build

# ROS 2 інструменти для демо блоку 5: colcon workspace, ament_auto і graph GUI.
#python3-colcon-common-extensions
#ros-jazzy-ament-cmake-auto
#ros-jazzy-rosidl-default-generators
#ros-jazzy-rqt-graph

# CycloneDDS використовується як default RMW для стабільнішого discovery
# у devcontainer.
#ros-jazzy-rmw-cyclonedds-cpp

# ROS Jazzy iceoryx потрібен для demo 5.5: RouDi daemon, SharedMemory transport
# і сумісний introspection client. Ubuntu package `iceoryx` не додається, бо
# його build version може не збігатися з ROS Jazzy RouDi.
#ros-jazzy-iceoryx-posh
#ros-jazzy-iceoryx-introspection
